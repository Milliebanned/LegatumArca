# Arc mainnet — verified against docs.arc.io (Sept 2026); see memory.md
# Decision 7 for sourcing. Confirm against docs.arc.io / circle.com before
# a real deployment, since these can still change.
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_CHAIN_ID=5042
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
PRIVATE_KEY=

# Payout keeper wallet (pays gas only) and the Vercel cron secret. Set the same
# values in the Vercel project's environment variables, plus KEEPER_NETWORK
# ("mainnet" or "testnet"; required, the keeper refuses to run without it).
# FACTORY_ADDRESS is optional there: it overrides frontend/src/deployedMainnet.js.
KEEPER_PRIVATE_KEY=
CRON_SECRET=
